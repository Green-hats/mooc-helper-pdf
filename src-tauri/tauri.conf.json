{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mooc-helper",
  "version": "0.2.3",
  "identifier": "com.lujunji.mooc-helper",
  "build": {
    "beforeBuildCommand": "cross-env NEXT_PUBLIC_TAURI=1 npm run export",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "fullscreen": false,
        "center": true,
        "width": 1024,
        "height": 768,
        "resizable": true,
        "title": "mooc-helper"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "copyright": "",
    "createUpdaterArtifacts": true,
    "externalBin": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "longDescription": "",
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null
    },
    "resources": [],
    "shortDescription": "",
    "targets": "all",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "wix": {
        "language": "zh-CN"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://mooc-helper.vercel.app/api/update/{{target}}/{{current_version}}"
      ],
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVCODEwRkUzQUE1MDlEQzAKUldUQW5WQ3E0dytCNjlaNlBlNTJ3S01pQ2luTExjYW42dGZPdjRoMjlHb0FreTJaNVJnMGtYelIK"
    }
  }
}
